# DeepSense 6G Scenarios 31 and 33: third-party recordings, obtained by the user.
# See data/README.md. Never versioned.
datasets/

# Large regenerable intermediates: preprocessing caches and trained weights.
experiments/cache/
experiments/checkpoints/
/cache/
/results/

# Result records. ALLOW-LISTED, not exclusion-listed: everything one level inside
# results/ is ignored, then the JSONs the paper is generated from and the four arrays the
# verification suite needs are negated back in. An exclusion list missed model checkpoints
# under results/v5 and results/v6 and prediction arrays under results/preds, because
# `results/*.npz` matches one level only. Ignoring the directory entries means git never
# descends into them at all.
experiments/results/*
!experiments/results/*.json
!experiments/results/beam_shortlists_sc31.npz
!experiments/results/beam_shortlists_sc33.npz
!experiments/results/sc31_bearing_labels.npz
!experiments/results/sc33_bearing_labels.npz

# Model weights, anywhere.
*.pt
*.pth
*.ckpt

# Reference PDFs: third-party copyrighted articles, read but not redistributable.
refs/

# Figure build products. The TikZ sources, the rendered PDFs and the PNG previews are all
# regenerated by make_paper_b_figures.py, which IS tracked. Only the data record each one
# was drawn from is kept, which is what a reader needs to check a figure against the paper.
paper_b_figures/*
!paper_b_figures/figure_data.json
!paper_b_figures/CAPTIONS.md
paper_a_figures/

# Manuscript sources and correspondence are not in this repository.
paper_b/
paper_a_white_paper/
S2S-Diff*
Review.pdf
*.zip

# Project-internal planning and engineering records
CLAUDE.md
PROJECT_STATUS.md
PAPER_*_PLAN.md
PAPER_B_AUDIT_*.md
blueprint_notes.md
DATASETS.md
SparseDiffusion_reference_verification.txt
PROJECT_REVIEW_*.md

__pycache__/
*.pyc
*.aux
*.log
*.out
*.blg

# Tooling, logs and private correspondence: never versioned.
.claude/
*_log.txt
email_*.txt
cover_letter.txt

# Manuscript-derived content and correspondence tooling: the paper's text, extracted text,
# and the cover-letter generator belong with the submission, not in the code repository.
review_artifacts/**/PaperB.txt
review_artifacts/**/*.pdf
experiments/make_cover_letter_pdf.py

# External review write-ups: narrative reviews of the manuscript, not reproducibility code.
review_artifacts/**/*_review.md
review_artifacts/**/*review*.md

# The manuscript verifier reads PaperB.tex, the rendered PDF and the cover letter, none of
# which are in this repository, so it cannot run here. It also encodes submission-specific
# detail: author-block probes, forbidden phrases from past correspondence. It stays local.
experiments/verify_paper_b_manuscript.py
